{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kajiya.local/schemas/kajiya-task-brief.schema.json",
  "title": "Kajiya Task Brief",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "issue_id",
    "source_of_truth",
    "human_instruction",
    "evidence_refs",
    "allowed_files",
    "validation_commands",
    "forbidden_actions",
    "builder_mode",
    "requires_human_approval",
    "next_safe_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "kajiya.task_brief.v1"
    },
    "kind": {
      "const": "kajiya_task_brief"
    },
    "issue_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "source_of_truth": {
      "type": "string"
    },
    "human_instruction": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "builder_mode": {
      "const": "bounded_patch_plan"
    },
    "requires_human_approval": {
      "type": "boolean"
    },
    "next_safe_actions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
